# 环境变量文件（⚠️ 重要！绝对不要提交）
.env

# 构建输出
dist/
build/
*.egg-info/
.eggs/

# 测试和日志
.pytest_cache/
.coverage
*.log

# 操作系统文件
.DS_Store
Thumbs.db
